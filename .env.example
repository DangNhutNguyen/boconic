APP_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_BASE_URL=http://localhost:8000

# CSDL: Mặc định SQLite cục bộ (Chạy trực tiếp không cần cài PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/boconic.db
# Nếu dùng PostgreSQL ngoài hoặc Docker Compose:
# DATABASE_URL=postgresql+asyncpg://boconic:boconic_secure_pw@postgres:5432/boconic
# DATABASE_URL=postgresql+asyncpg://boconic:boconic_secure_pw@localhost:5432/boconic

BOT_TOKEN=
BOT_USERNAME=
ADMIN_USERNAME=your_admin_username
ADMIN_TELEGRAM_ID=
ADMIN_LOGIN=admin
SECRET_KEY=boconic_super_secure_secret_key_change_me_in_production_min_32_chars
BOT_API_KEY=boconic_internal_bot_api_key_32_chars_min
DEMO_MODE=false
OCR_ENABLED=false
AI_QUERY_ENABLED=false
SEMANTIC_SEARCH_ENABLED=false
AI_PROVIDER=disabled
AI_API_KEY=
STORAGE_DIR=./data/storage
BACKUP_DIR=./data/backups
UPLOAD_MAX_MB=10
